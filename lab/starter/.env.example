# Salin jadi .env kalau perlu mengganti port / password (file .env TIDAK di-commit ke Git).
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
API_PORT=8000
MLFLOW_PORT=5001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=ganti-password-ini
# Kalau MLFLOW_PORT diganti, set juga untuk script di laptop:
#   PowerShell: $env:MLFLOW_TRACKING_URI="http://localhost:5001"
#   macOS/Linux: export MLFLOW_TRACKING_URI=http://localhost:5001
